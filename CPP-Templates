template <typename T>
class Calculator
{
private:
    T a, b;

public:
    Calculator(T x, T y) : a{x}, b{y} {}

    T add()
    {
        return a + b;
    }
};

// This is a sampel of a C++ programming snippet for creating templates and we could use T as a typename and pass parameters through it. Templates help render multiple data types.
